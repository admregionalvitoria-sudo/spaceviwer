{
  "name": "spaceviewer",
  "version": "2.2.21",
  "description": "Screen mirroring and casting over local network",
  "repository": {
    "type": "git",
    "url": "https://github.com/admregionalvitoria-sudo/spaceviwer.git"
  },
  "main": "./out/main/index.js",
  "author": "SpaceViewer",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build:native && electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:host": "node --test tests/host-regressions.cjs"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "clsx": "^2.1.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "framer-motion": "^11.0.0",
    "qrcode": "^1.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.0",
    "simple-peer": "^9.11.1",
    "tailwind-merge": "^2.2.1",
    "ws": "^8.16.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/simple-peer": "^9.11.8",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
